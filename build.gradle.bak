plugins {
  id("org.jetbrains.kotlin.jvm") version "1.9.23"
  id("dev.magicspells.msjava")
  // 0.36+ requires Kotlin 2.2; this project uses Kotlin 1.9.x
  id("com.vanniktech.maven.publish") version "0.30.0" apply false
}

wrapper {
  gradleVersion = "8.4"
  setDistributionType(Wrapper.DistributionType.ALL)
}

gradle.taskGraph.whenReady { graph ->
  def publishingToCentral = graph.allTasks.any { task ->
    task.name.endsWith("publishToMavenCentral") ||
      task.name.endsWith("publishAndReleaseToMavenCentral") ||
      task.name.contains("publishAllPublicationsToMavenCentral") ||
      task.name.contains("publishMavenPublicationToMavenCentral")
  }
  if (!publishingToCentral) {
    return
  }

  def missing = []
  if (!findProperty("mavenCentralUsername")) {
    missing.add("mavenCentralUsername")
  }
  if (!findProperty("mavenCentralPassword")) {
    missing.add("mavenCentralPassword")
  }
  def useGpgCmd = findProperty("signing.gnupg.useGpgCmd")?.toString() != "false"
  def hasInMemoryKey = findProperty("signing.inMemoryKey") != null

  if (!findProperty("signing.keyId") && !hasInMemoryKey) {
    missing.add("signing.keyId (or signing.inMemoryKey)")
  }
  if (!findProperty("signing.password")) {
    missing.add("signing.password")
  }
  if (!useGpgCmd && !hasInMemoryKey && !findProperty("signing.secretKeyRingFile")) {
    missing.add("signing.secretKeyRingFile (or set signing.gnupg.useGpgCmd=true)")
  }

  if (!missing.isEmpty()) {
    throw new GradleException(
      "Maven Central publish is not configured. Add these properties to .gradle/gradle.properties " +
        "(in this repo, gitignored) or ~/.gradle/gradle.properties (see gradle.properties.example):\n  - " +
        missing.join("\n  - ")
    )
  }
}

subprojects {
  apply plugin: "dev.magicspells.msjava"
  apply plugin: "org.jetbrains.kotlin.jvm"

  dependencies {
    implementation(group: "io.papermc.paper", name: "paper-api", version: "1.21.4-R0.1-SNAPSHOT")
  }

  processResources {
    expand(["version": version])
  }

  // Paperweight NMS modules are build-time only; publish library modules to Maven Central.
  if (project.path != ":nms" && project.path != ":nms:v1_21_4") {
    apply plugin: "com.vanniktech.maven.publish"

    group = findProperty("mavenCentralGroup") ?: "io.github.team-sneakymouse"

    def mavenArtifactIdForProject = {
      switch (project.path) {
        case ":core":
          return "magicspells-core"
        case ":nms:shared":
          return "magicspells-nms-shared"
        default:
          return "magicspells-${project.name}"
      }
    }

    tasks.withType(Javadoc).configureEach {
      options.encoding = "UTF-8"
      options.addStringOption("Xdoclint:none", "-quiet")
      failOnError = false
    }

    plugins.withId("signing") {
      signing {
        def inMemoryKey = findProperty("signing.inMemoryKey")
        if (inMemoryKey != null) {
          // Properties files cannot hold multiline keys; allow escaped newlines.
          def normalizedKey = inMemoryKey.toString().replace("\\n", "\n")
          useInMemoryPgpKeys(normalizedKey, findProperty("signing.password")?.toString())
        } else if (findProperty("signing.keyId") != null) {
          def gpgCmdEnabled = findProperty("signing.gnupg.useGpgCmd")?.toString() != "false"
          if (gpgCmdEnabled) {
            useGpgCmd()
          }
        }
      }
    }

    mavenPublishing {
      publishToMavenCentral(com.vanniktech.maven.publish.SonatypeHost.CENTRAL_PORTAL)
      if (findProperty("signing.keyId") != null || findProperty("signing.inMemoryKey") != null) {
        signAllPublications()
      }

      coordinates(
        project.group as String,
        mavenArtifactIdForProject(),
        project.version as String
      )

      pom {
        name.set(findProperty("POM_NAME") ?: "MagicSpells")
        description.set(findProperty("POM_DESCRIPTION")
          ?: "Paper plugin framework for configurable spells and server mechanics.")
        inceptionYear.set(findProperty("POM_INCEPTION_YEAR") ?: "2011")
        url.set(findProperty("POM_URL") ?: "https://github.com/Team-Sneakymouse/MagicSpells")

        licenses {
          license {
            name.set(findProperty("POM_LICENSE_NAME") ?: "GNU General Public License v3.0")
            url.set(findProperty("POM_LICENSE_URL") ?: "https://www.gnu.org/licenses/gpl-3.0.txt")
          }
        }

        developers {
          developer {
            id.set(findProperty("POM_DEVELOPER_ID") ?: "team-sneakymouse")
            name.set(findProperty("POM_DEVELOPER_NAME") ?: "Team Sneakymouse")
            url.set(findProperty("POM_DEVELOPER_URL") ?: "https://github.com/Team-Sneakymouse")
          }
        }

        scm {
          url.set(findProperty("POM_SCM_URL") ?: "https://github.com/Team-Sneakymouse/MagicSpells")
          connection.set(findProperty("POM_SCM_CONNECTION")
            ?: "scm:git:git@github.com:Team-Sneakymouse/MagicSpells.git")
          developerConnection.set(findProperty("POM_SCM_DEVELOPER_CONNECTION")
            ?: "scm:git:git@github.com:Team-Sneakymouse/MagicSpells.git")
        }
      }
    }
  }
}