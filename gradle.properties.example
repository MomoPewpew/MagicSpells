# Copy to .gradle/gradle.properties in this repo (gitignored).
# Never commit real credentials.
#
# Release version is set in the project gradle.properties (version = ...), not here.
# Maven Central releases must not use a -SNAPSHOT version (4.0-Beta-13 is fine).

# --- Maven Central (Sonatype Central Portal user token) ---
# https://central.sonatype.com/usertoken
mavenCentralUsername=YOUR_SONATYPE_TOKEN_USERNAME
mavenCentralPassword=YOUR_SONATYPE_TOKEN_PASSWORD

# --- GPG signing (recommended: use the gpg binary + your existing keyring) ---
# gpg --list-secret-keys --keyid-format=long
# Example: 832323DC1DB717418F44864FEBF4CD1B48122A0D -> signing.keyId=48122A0D
signing.keyId=LAST_8_CHARS_OF_KEY_ID
signing.password=YOUR_GPG_KEY_PASSPHRASE
signing.gnupg.useGpgCmd=true

# Alternative: legacy secring file (export with gpg --export-secret-keys KEY_ID > ~/.gnupg/secring.gpg)
# signing.secretKeyRingFile=/home/YOU/.gnupg/secring.gpg
# signing.gnupg.useGpgCmd=false

# Alternative: in-memory key for CI (paste armored key with real line breaks, or use \n escapes)
# signing.inMemoryKey=-----BEGIN PGP PRIVATE KEY BLOCK-----\n...
